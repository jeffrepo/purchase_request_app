<odoo>
    <record id="stock_picking_form_inherit_purchase_request" model="ir.ui.view">
        <field name="name">stock.picking.form.purchase.request</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header/button[@name='do_print_picking']" position="before">
                <button name="%(stock.action_report_picking)d" type="action"
                        string="Imprimir traslado" groups="stock.group_stock_user"
                        invisible="not purchase_request_id or picking_type_code != 'internal'"/>
            </xpath>
            <xpath expr="//sheet//group" position="inside">
                <field name="purchase_request_id" readonly="1"/>
            </xpath>
        </field>
    </record>
</odoo>
